# ===== AETHON AI Frontend Environment =====
# Copy this to .env and fill in your values

# Mock mode — set to "true" to use local mock data instead of the backend API
VITE_USE_MOCK=true

# Backend API base URL (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000/api

# Socket.IO URL for real-time investigation pipeline events
VITE_SOCKET_URL=http://localhost:8000

# Mapbox token for geolocation map rendering
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
